FROM apache/airflow:3.1.8-python3.11

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        chromium-driver \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/news-project /opt/scraper-venv \
    && chown -R airflow:0 /opt/news-project /opt/scraper-venv

USER airflow

RUN pip install --no-cache-dir uv

COPY --chown=airflow:0 requirements-scraper.txt /tmp/requirements-scraper.txt

RUN uv venv /opt/scraper-venv \
    && uv pip install \
        --python /opt/scraper-venv/bin/python \
        -r /tmp/requirements-scraper.txt

ENV BROWSER_BINARY_PATH=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver